# Paths (absolute on host)
APPDATA=/srv/docker/appdata
MEDIA_ROOT=/mnt/storage/media
DATA_ROOT=/mnt/storage/data
SCRATCH_NVME=/srv/scratch/qbit
TDARR_CACHE=/srv/cache/tdarr
TZ=Europe/Stockholm
LAN_SUBNET=192.168.0.0/24

# Public IP / DNS used as WireGuard endpoint advertisement
PUBLIC_IP=vpn.example.org

# VPN provider's endpoint (used to allow direct routing outside the tunnel)
VPN_ENDPOINT_CIDR=203.0.113.10/32

# Watchtower → Discord notifications
DISCORD_WATCHTOWER=https://discord.com/api/webhooks/REDACTED

# Jellystat
JS_PORT=3000
JS_DB_USER=jellystat
JS_DB_PASSWORD=change-me
JS_DB_NAME=jfstat
JS_JWT_SECRET=change-me

# Unpackerr → *arr API keys
UN_SONARR_0_API_KEY=REDACTED
UN_RADARR_0_API_KEY=REDACTED
